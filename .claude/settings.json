{
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sudo rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(curl*| sh*)",
      "Bash(curl*|sh*)",
      "Bash(curl*| bash*)",
      "Bash(curl*|bash*)",
      "Bash(wget*| sh*)",
      "Bash(wget*| bash*)",
      "Bash(cat*.env*)",
      "Bash(cat .env*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Write(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.js\"",
            "shell": "bash",
            "statusMessage": "Safety check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-session-prompts.js\"",
            "shell": "bash",
            "statusMessage": "Logging session prompts"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit-push.js\"",
            "shell": "bash",
            "statusMessage": "Auto commit & push",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
